# ─── Shared Twilio credentials (same account as the other demos/POCs) ───────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=                      # used by twilio-run to deploy the Functions
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=

# ─── The WhatsApp sender this POC OWNS (its inbound wiring gets flipped) ───
TWILIO_WHATSAPP_NUMBER=whatsapp:+1xxxxxxxxxx
WHATSAPP_SENDER_SID=                    # XE…; blank = provision looks it up by address

# ─── Scenario B only ──────────────────────────────────────────────────────
# Conversations service for the autocreated conversations. Blank = the account's
# DEFAULT service. Set it if the default service carries other demos' webhooks.
CONVERSATIONS_SERVICE_SID=

# ─── Router behaviour (pushed to the Functions environment by provision) ───
RESET_KEYWORD=reset          # scenario A: texting this clears the stack + ends active executions
STACK_TTL_SECONDS=14400      # scenario A: = the parent's TwiML Redirect timeout (4h max)
MAX_DEPTH=8                  # /call refuses to push past this (runaway-loop guard)
END_CHILD_ON_RETURN=false    # scenario A: set true if smoke test A-B3 shows child executions stay ACTIVE after /return

# ─── Provisioned ids — written by `npm run provision`, leave blank ────────
ACTIVE_SCENARIO=             # which scenario the sender is wired for right now
SYNC_SERVICE_SID=
SYNC_MAP_NAME=stacks
SERVERLESS_SERVICE_SID=
SERVERLESS_ENV_SID=
SERVERLESS_DOMAIN=
FRAME_FUNCTION_SID=
CALL_FUNCTION_SID=
RETURN_FUNCTION_SID=
L0_FLOW_SID=                 # scenario A flows
L1_FLOW_SID=
L2_FLOW_SID=
L3_FLOW_SID=
CONV_L0_FLOW_SID=            # scenario B flows
CONV_L1_FLOW_SID=
CONV_L2_FLOW_SID=
CONV_L3_FLOW_SID=
ADDRESS_CONFIG_SID=          # scenario B: the sender's Address Configuration (IG…)
PREVIOUS_SENDER_WEBHOOK=     # what the sender's inbound webhook was before provision (teardown restores it)
MESSAGING_SERVICE_SID=       # the Messaging Service the sender sits in — ITS inbound URL is what Twilio calls (see SETUP §9)
PREVIOUS_MS_INBOUND_URL=     # that service's inbound URL before provision (teardown restores it)
PREVIOUS_ADDRESS_CONFIG_FLOW_SID=   # if an Address Configuration already existed on the sender: its flow (teardown restores instead of deleting)
PREVIOUS_ADDRESS_CONFIG_ENABLED=
